{
  "name": "jev-mcp-server",
  "version": "1.1.0",
  "description": "A read-only MCP safety gate for evaluating potentially destructive commands.",
  "main": "dist/index.js",
  "bin": {
    "jev-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify-test-safety": "npm run build && node dist/test-safety-cli.js",
    "start": "node dist/index.js",
    "test": "npm run build && JEV_CACHE_DB_PATH=:memory: node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuji-soho/jev-mcp-server.git"
  },
  "keywords": ["mcp", "safety", "command", "codex", "ai-agent"],
  "author": "fuji-soho",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fuji-soho/jev-mcp-server/issues"
  },
  "homepage": "https://github.com/fuji-soho/jev-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
